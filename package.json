{
  "name": "map-service",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "manage": "node scripts/manage.mjs",
    "test:launcher": "node --test --test-isolation=none tests/manage.test.mjs",
    "inspect:tpk": "tsx scripts/inspect-tpk.ts",
    "test:tiles": "tsx --test tests/tpk.test.ts tests/catalog.test.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "leaflet": "1.9.4",
    "yauzl": "3.4.0",
    "fast-xml-parser": "5.12.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "@types/leaflet": "1.9.22",
    "@types/yauzl": "3.4.0",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "type": "module"
}
