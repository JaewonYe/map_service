# Copy to .env.downloads locally; .env.downloads is ignored by Git and Docker builds.
# Worker/CLI only. Do not use NEXT_PUBLIC_* or paste credentials into chat.
ARCGIS_TOKEN=
OPENTOPOGRAPHY_API_KEY=
# Optional custom host folders; create them and grant the container user read/write access.
MAP_DOWNLOADS_HOST_DIR=./data/downloads
IMAGERY_HOST_DIR=./data/imagery
DEM_HOST_DIR=./data/dem
