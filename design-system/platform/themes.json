{
  "version": "2.0.0",
  "variables": {
    "font-body": "Pretendard, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans KR\", \"Malgun Gothic\", sans-serif",
    "font-size-body": "1rem",
    "font-size-small": "0.875rem",
    "font-size-heading": "1.5rem",
    "line-height-body": "1.5",
    "space-1": "0.25rem",
    "space-2": "0.5rem",
    "space-3": "0.75rem",
    "space-4": "1rem",
    "space-6": "1.5rem",
    "space-8": "2rem",
    "radius-control": "0.375rem",
    "radius-panel": "0.5rem",
    "control-min-height": "2.75rem",
    "header-height": "3.5rem"
  },
  "themes": {
    "light": {
      "color-background": "#f5f7fa",
      "color-surface": "#ffffff",
      "color-surface-raised": "#ffffff",
      "color-header": "#172b4d",
      "color-on-header": "#ffffff",
      "color-foreground": "#172b4d",
      "color-muted-foreground": "#526078",
      "color-primary": "#0f766e",
      "color-primary-hover": "#115e59",
      "color-on-primary": "#ffffff",
      "color-accent": "#0f766e",
      "color-primary-subtle": "#e0f2ef",
      "color-on-primary-subtle": "#115e59",
      "color-muted-border": "#dfe5ec",
      "color-control-border": "#64748b",
      "color-focus": "#2563eb",
      "color-danger": "#b91c1c",
      "color-on-danger": "#ffffff",
      "color-warning": "#854d0e",
      "color-warning-subtle": "#fef3c7",
      "map-terrain": "#e7efe4",
      "map-road": "#ffffff",
      "map-road-border": "#b1bec8",
      "map-building": "#d4dce2",
      "map-water": "#b5dce9",
      "map-label": "#172b4d",
      "map-selection-stroke": "#0f766e",
      "map-selection-fill": "#0f766e26",
      "color-header-accent": "#2dd4bf"
    },
    "dark": {
      "color-background": "#0b1220",
      "color-surface": "#111c2e",
      "color-surface-raised": "#17263c",
      "color-header": "#0d1b2b",
      "color-on-header": "#e6edf7",
      "color-foreground": "#e6edf7",
      "color-muted-foreground": "#a9b8cc",
      "color-primary": "#0f766e",
      "color-primary-hover": "#115e59",
      "color-on-primary": "#ffffff",
      "color-accent": "#2dd4bf",
      "color-primary-subtle": "#134e4a",
      "color-on-primary-subtle": "#99f6e4",
      "color-muted-border": "#2b3c54",
      "color-control-border": "#73869f",
      "color-focus": "#60a5fa",
      "color-danger": "#b91c1c",
      "color-on-danger": "#ffffff",
      "color-warning": "#fde68a",
      "color-warning-subtle": "#422f15",
      "map-terrain": "#173a32",
      "map-road": "#52647c",
      "map-road-border": "#29374b",
      "map-building": "#283b50",
      "map-water": "#113d5d",
      "map-label": "#e6edf7",
      "map-selection-stroke": "#2dd4bf",
      "map-selection-fill": "#2dd4bf26",
      "color-header-accent": "#2dd4bf"
    }
  },
  "contrast_checks": [
    {
      "foreground": "color-foreground",
      "background": "color-surface",
      "minimum": 4.5
    },
    {
      "foreground": "color-muted-foreground",
      "background": "color-surface",
      "minimum": 4.5
    },
    {
      "foreground": "color-on-primary",
      "background": "color-primary",
      "minimum": 4.5
    },
    {
      "foreground": "color-on-danger",
      "background": "color-danger",
      "minimum": 4.5
    },
    {
      "foreground": "color-warning",
      "background": "color-warning-subtle",
      "minimum": 4.5
    },
    {
      "foreground": "color-on-header",
      "background": "color-header",
      "minimum": 4.5
    },
    {
      "foreground": "color-on-primary-subtle",
      "background": "color-primary-subtle",
      "minimum": 4.5
    },
    {
      "foreground": "color-control-border",
      "background": "color-surface",
      "minimum": 3
    },
    {
      "foreground": "color-focus",
      "background": "color-surface",
      "minimum": 3
    },
    {
      "foreground": "color-on-header",
      "background": "color-header",
      "minimum": 4.5
    },
    {
      "foreground": "color-header-accent",
      "background": "color-header",
      "minimum": 3
    },
    {
      "foreground": "color-on-primary-subtle",
      "background": "color-primary-subtle",
      "minimum": 4.5
    }
  ]
}
