BIND_ADDRESS=127.0.0.1
PORT=3001
TPK_HOST_DIR=./data/tpk
TPK_FILE=map.tpk
# npm run dev uses this host-side path; Compose sets its own container path.
TPK_PATH=data/tpk/map.tpk
TPK_CACHE_DIR=.cache/tpk
# Confirm permitted internal web use for the actual package before serving its tiles.
TPK_USAGE_CONFIRMED=false
MAP_MODE=offline
OSM_HOST_DIR=./data/osm
OSM_TILE_DIR=data/osm
OSM_USAGE_CONFIRMED=false
