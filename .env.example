BIND_ADDRESS=127.0.0.1
PORT=3001
TPK_HOST_DIR=./data/tpk
TPK_FILE=map.tpk
# Optional catalog inside TPK_HOST_DIR; absent maps.json retains single-TPK mode.
MAP_CONFIG_FILE=maps.json
# npm run dev uses this host-side path; Compose sets its own container path.
TPK_PATH=data/tpk/map.tpk
TPK_CACHE_DIR=.cache/tpk
# Confirm permitted internal web use for the actual package before serving its tiles.
TPK_USAGE_CONFIRMED=false
MAP_MODE=offline
OSM_HOST_DIR=./data/osm
OSM_TILE_DIR=data/osm
OSM_PBF_FILE=south-korea.osm.pbf
OSM_USAGE_CONFIRMED=false
BUILDINGS_HOST_DIR=./data/buildings
BUILDINGS_DIR=data/buildings
# General/street map: separate raster TPK, not World Imagery or a vector PBF.
STREET_HOST_DIR=./data/street
STREET_TPK_DIR=data/street
STREET_USAGE_CONFIRMED=false
# Elevation: copy an authorised, single-band DEM GeoTIFF (values in metres).
ELEVATION_HOST_DIR=./data/elevation
ELEVATION_DIR=data/elevation
ELEVATION_USAGE_CONFIRMED=false
DEM_MIN_ZOOM=8
DEM_MAX_ZOOM=13
DEM_SOURCE=Local DEM
DEM_ATTRIBUTION=Local DEM; see source licence
DEM_VERTICAL_DATUM=Unknown vertical datum
